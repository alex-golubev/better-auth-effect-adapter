{
  "name": "better-auth-effect",
  "version": "0.4.0",
  "description": "Better Auth adapter for @effect/sql",
  "author": "Alex Golubev",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run --config vitest.all.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test && pnpm lint"
  },
  "peerDependencies": {
    "@effect/sql": ">=0.49.0",
    "better-auth": ">=1.2.0",
    "effect": ">=3.15.0"
  },
  "devDependencies": {
    "@better-auth/test-utils": "^1.5.3",
    "@effect/experimental": "0.58.0",
    "@effect/platform": "0.94.4",
    "@effect/sql": "^0.49.0",
    "@effect/sql-mysql2": "^0.50.0",
    "@effect/sql-pg": "^0.50.3",
    "@effect/sql-sqlite-node": "^0.50.1",
    "@eslint/js": "^9.39.3",
    "@testcontainers/mysql": "^11.12.0",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/better-sqlite3": "^7.6.13",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "better-auth": "^1.5.3",
    "better-sqlite3": "^12.6.2",
    "effect": "^3.19.19",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.1",
  "pnpm": {
    "overrides": {
      "glob": "^13.0.1"
    }
  },
  "keywords": [
    "better-auth",
    "effect",
    "effect-ts",
    "sql",
    "adapter",
    "authentication",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-golubev/better-auth-effect-adapter.git"
  },
  "homepage": "https://github.com/alex-golubev/better-auth-effect-adapter#readme",
  "bugs": {
    "url": "https://github.com/alex-golubev/better-auth-effect-adapter/issues"
  }
}
