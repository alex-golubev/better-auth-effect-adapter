{
  "name": "better-auth-effect",
  "version": "1.0.0",
  "description": "Better Auth database adapter for Effect SQL (effect/sql)",
  "author": "Alex Golubev",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm check && pnpm test:all",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "peerDependencies": {
    "better-auth": "^1.7.0",
    "effect": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.29.1",
  "keywords": [
    "better-auth",
    "effect",
    "effect-ts",
    "sql",
    "adapter",
    "authentication",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-golubev/better-auth-effect-adapter.git"
  },
  "homepage": "https://github.com/alex-golubev/better-auth-effect-adapter#readme",
  "bugs": {
    "url": "https://github.com/alex-golubev/better-auth-effect-adapter/issues"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.22",
    "@better-auth/test-utils": "1.7.22",
    "@biomejs/biome": "2.6.7",
    "@effect/sql-mysql2": "4.1.4",
    "@effect/sql-pg": "4.1.4",
    "@effect/sql-sqlite-node": "4.1.4",
    "@effect/tsgo": "0.68.1",
    "@effect/vitest": "4.1.4",
    "@testcontainers/mysql": "12.2.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "better-auth": "1.7.22",
    "effect": "4.1.4",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
