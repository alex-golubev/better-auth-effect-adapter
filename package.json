{
  "name": "better-auth-effect",
  "version": "0.1.0",
  "description": "Better Auth adapter for @effect/sql",
  "author": "Alex Golubev",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test && pnpm lint"
  },
  "peerDependencies": {
    "@effect/sql": ">=0.26.0",
    "better-auth": ">=1.0.0",
    "effect": ">=3.12.0"
  },
  "devDependencies": {
    "@effect/experimental": "0.58.0",
    "@effect/platform": "0.94.1",
    "@effect/sql": "^0.49.0",
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "better-auth": "^1.2.0",
    "effect": "^3.19.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "better-auth",
    "effect",
    "effect-ts",
    "sql",
    "adapter",
    "authentication",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex/better-auth-effect-adapter.git"
  },
  "homepage": "https://github.com/alex-golubev/better-auth-effect-adapter#readme",
  "bugs": {
    "url": "https://github.com/alex-golubev/better-auth-effect-adapter/issues"
  }
}
